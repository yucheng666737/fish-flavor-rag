# 真實金鑰只填在 .env；不要填進這份範例或瀏覽器。
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PORT=3000
# 預設讀取已標示為示範的文字；可改為你已確認可傳送至 OpenAI 的資料夾。
RAG_KNOWLEDGE_DIR=knowledge/demo
RAG_INDEX_PATH=.data/index.json
RAG_MIN_SCORE=0.30
RAG_TOP_K=5

# 保留 local 直到 Pinecone 匯入與驗證成功，再改為 pinecone。
RAG_STORE=local
PINECONE_API_KEY=
# 在 Starter 建立 dense / 1536 維 / cosine / 自行提供向量的索引。
PINECONE_INDEX=fish-flavor-rag
PINECONE_NAMESPACE=fish-rag
